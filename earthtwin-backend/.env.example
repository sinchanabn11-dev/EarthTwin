# EarthTwin Backend Configuration
# Copy this file to .env and configure values if using live Supabase

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True

# CORS - Comma-separated list of allowed frontend origins
# http://localhost:5173 is Vite default, http://localhost:3000 is AI Studio / Create React App default
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Supabase PostgreSQL Configuration (Optional for initial demo)
# Leave blank to automatically use realistic in-memory mock data
SUPABASE_URL=
SUPABASE_KEY=

# ML Model Configuration (Optional future expansion)
ML_MODEL_PATH=./app/ml/models/ecosystem_model.pkl
USE_ML_PREDICTOR=False
